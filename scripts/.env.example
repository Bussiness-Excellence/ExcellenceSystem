# ==========================================================================
#  Excellence CRM — environment configuration
#
#  1. Copy this file to ".env"  (cp .env.example .env)
#  2. Fill in the real values below.
#  3. NEVER commit ".env" to git. The bundled .gitignore already blocks it.
# ==========================================================================

# --- Supabase project URL (Settings -> API -> Project URL) ---------------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# --- Service role key (Settings -> API -> service_role, "secret") --------
#  Bypasses Row Level Security. Required for the upload/hierarchy scripts.
#  Treat this like a database root password.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anon / publishable key (Settings -> API -> anon, "public") ----------
#  Safe for the browser. Used by read-only inspection scripts.
SUPABASE_ANON_KEY=

# --- React app (Create React App only exposes REACT_APP_* vars) ----------
#  These belong in the webapp's own .env. Only ever put the ANON key here —
#  anything in REACT_APP_* is shipped to the browser and is public.
REACT_APP_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
REACT_APP_SUPABASE_ANON_KEY=

# ==========================================================================
#  Local data folders (override if your drive layout differs)
# ==========================================================================
CRM_ROOT=E:\crm extractor
PERIOD_RECENT_DIR=E:\crm extractor\Periods\recent
PERIOD_LAST_MONTH_DIR=E:\crm extractor\Periods\last_month
HIERARCHY_FILE=E:\crm extractor\hierarchy\hierarchy_export.xlsx
HIERARCHY_SQL_OUT=E:\crm extractor\hierarchy\hierarchy_replace.sql
